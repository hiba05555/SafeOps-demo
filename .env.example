# copy to .env (docker compose reads it automatically). Dev/test values only.

# host ports
KEYCLOAK_PORT=8080
GATEWAY_PORT=8888
FRONTEND_PORT=3000

# Keycloak master admin (http://localhost:8080/admin)
KC_ADMIN=admin
KC_ADMIN_PASSWORD=change-me-admin

# queue-service database
POSTGRES_PASSWORD=change-me-db

# test accounts created in realm "tiko" by keycloak/bootstrap.sh
# usernames: client (client role), agent (agent role), admin (admin + agent roles)
TIKO_CLIENT_PASSWORD=change-me-client
TIKO_AGENT_PASSWORD=change-me-agent
TIKO_ADMIN_PASSWORD=change-me-admin
